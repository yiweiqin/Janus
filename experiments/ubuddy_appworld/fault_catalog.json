{
  "version": "ubuddy_appworld_fault_catalog_v1",
  "faults": [
    {"id": "stale_profile", "layer": "organization", "observable": "selection_snapshot.profileRevision < latest_profile.profileRevision"},
    {"id": "wrong_recipient", "layer": "organization", "observable": "selected_profile.capabilityTags do not cover subtask"},
    {"id": "dependency_order", "layer": "organization", "observable": "downstream starts before upstream result adopted"},
    {"id": "superseded_result", "layer": "organization", "observable": "downstream consumes result.status=superseded"},
    {"id": "individual_gap", "layer": "individual", "observable": "recipient repeats validated capability failure"},
    {"id": "tool_failure", "layer": "environment", "observable": "official AppWorld API returns tool/environment error"},
    {"id": "requirement_revision", "layer": "organization", "observable": "new revision invalidates prior result"},
    {"id": "insufficient_evidence", "layer": "blocked", "observable": "missing trace, profile snapshot, or official evaluation"}
  ]
}

