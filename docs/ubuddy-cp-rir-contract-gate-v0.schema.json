  "properties":{
    "$schema":{"const":"ubuddy-cp-rir-contract-gate-v0.schema.json"},
    "schemaVersion":{"const":"cp-rir/contract-gate/v0"},
    "status":{"const":"illustrative_v0_draft"},
    "normativeRegistry":{"type":"object","additionalProperties":false,"required":["registryDigest","independentFromCandidate","lockedBeforeCandidate"],"properties":{"registryDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"independentFromCandidate":{"type":"boolean"},"lockedBeforeCandidate":{"type":"boolean"}}},
    "contractBefore":{"$ref":"#/$defs/contract"},"contractAfter":{"$ref":"#/$defs/contract"},
    "modelSet":{"type":"object","additionalProperties":false,"required":["worldIds","preRegistered","candidateDependentFilter","closureDigest","preRegisteredAt","baselineId"],"properties":{"worldIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"preRegistered":{"type":"boolean"},"candidateDependentFilter":{"type":"boolean"},"closureDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"preRegisteredAt":{"type":"string","minLength":1},"baselineId":{"type":"string","minLength":1}}},
    "actionLibrary":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["actionId","typed","cost","ownerId","effectClass"],"properties":{"actionId":{"type":"string","minLength":1},"typed":{"type":"boolean"},"cost":{"type":"number","exclusiveMinimum":0},"ownerId":{"type":"string","minLength":1},"effectClass":{"type":"string","minLength":1}}}},
    "baseline":{"type":"object","additionalProperties":false,"required":["baselineId","candidateIndependent","cost","nonTrivial","valueLowerBound"],"properties":{"baselineId":{"type":"string","minLength":1},"candidateIndependent":{"type":"boolean"},"cost":{"type":"number","exclusiveMinimum":0},"nonTrivial":{"type":"boolean"},"valueLowerBound":{"type":"number"}}},
    "implementationStatus":{"const":"planned/unverified"}
