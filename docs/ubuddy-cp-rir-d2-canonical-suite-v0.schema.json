{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ubuddy.invalid/schemas/cp-rir-d2-canonical-suite-v0.json",
  "title": "Canonical answer-free D2 falsification suite (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "observerContract", "cases", "implementationStatus"],
  "properties": {
    "$schema": {"const": "ubuddy-cp-rir-d2-canonical-suite-v0.schema.json"},
    "schemaVersion": {"const": "cp-rir/d2-canonical-suite-input/v0"},
    "status": {"const": "illustrative_v0_draft"},
    "observerContract": {"type":"object","additionalProperties":false,"required":["solverVisible","comparatorPrivate","auditOnly"],"properties":{"solverVisible":{"const":["caseAlias","canonicalPayload"]},"comparatorPrivate":{"const":["expectedDisposition","mutationClass"]},"auditOnly":{"const":["credentialSecrets","signingKeys","rawReceiptEvidence"]}}},
    "cases": {"type":"array","minItems":6,"items":{"$ref":"#/$defs/case"}},
    "implementationStatus": {"const":"prototype/unverified"}
  },
  "$defs": {
    "effect": {"type":"object","additionalProperties":false,"required":["effectId","sinkId","resourceId","multiplicity","versionDelta"],"properties":{"effectId":{"type":["string","null"]},"sinkId":{"type":["string","null"]},"resourceId":{"type":["string","null"]},"multiplicity":{"type":"integer","minimum":0},"versionDelta":{"type":"integer","minimum":0}}},
    "edge": {"type":"object","additionalProperties":false,"required":["from","event","to","eventClass","effect"],"properties":{"from":{"type":"string"},"event":{"type":"string"},"to":{"type":"string"},"eventClass":{"enum":["INTERNAL","MEDIATED_EFFECT","UNMEDIATED_EFFECT","STUTTER"]},"effect":{"$ref":"#/$defs/effect"}}},
    "system": {"type":"object","additionalProperties":false,"required":["stateIds","initialStateId","terminalStateIds","badStateIds","transitions"],"properties":{"stateIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"initialStateId":{"type":"string"},"terminalStateIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"badStateIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"transitions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/edge"}}}},
    "map": {"type":"object","additionalProperties":false,"required":["from","to"],"properties":{"from":{"type":"string"},"to":{"type":"string"}}},
    "monitor": {"type":"object","additionalProperties":false,"required":["stateIds","initialStateId","violationStateIds","terminalClosureStateIds","rules"],"properties":{"stateIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"initialStateId":{"type":"string"},"violationStateIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"terminalClosureStateIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"rules":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["from","event","to"],"properties":{"from":{"type":"string"},"event":{"type":"string"},"to":{"type":"string"}}}}}},
    "fault": {"type":"object","additionalProperties":false,"required":["stateIds","initialStateId","faultEventIds","transitions"],"properties":{"stateIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"initialStateId":{"type":"string"},"faultEventIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"transitions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["from","event","to"],"properties":{"from":{"type":"string"},"event":{"type":"string"},"to":{"type":"string"}}}}}},
    "case": {"type":"object","additionalProperties":false,"required":["caseAlias","horizon","concrete","abstract","mapping","monitor","fault","trace","evidence"],"properties":{"caseAlias":{"type":"string","pattern":"^[A-Z0-9]{8}$"},"horizon":{"type":"integer","minimum":1,"maximum":8},"concrete":{"$ref":"#/$defs/system"},"abstract":{"$ref":"#/$defs/system"},"mapping":{"type":"object","additionalProperties":false,"required":["stateMap","eventMap"],"properties":{"stateMap":{"type":"array","items":{"$ref":"#/$defs/map"}},"eventMap":{"type":"array","items":{"$ref":"#/$defs/map"}}}},"monitor":{"$ref":"#/$defs/monitor"},"fault":{"$ref":"#/$defs/fault"},"trace":{"type":"object","additionalProperties":false,"required":["concreteEvents","abstractEvents"],"properties":{"concreteEvents":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/edge"}},"abstractEvents":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/edge"}}}},"evidence":{"type":"object","additionalProperties":false,"required":["attestationVerification","receiptVerification","recoveryVerification"],"properties":{"attestationVerification":{"const":"NOT_IMPLEMENTED"},"receiptVerification":{"const":"NOT_IMPLEMENTED"},"recoveryVerification":{"const":"NOT_IMPLEMENTED"}}}}}
  }
}
