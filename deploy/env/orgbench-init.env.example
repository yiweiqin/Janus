# Copy to deploy/env/orgbench-init.env on the remote host. Do not commit the real file.
NODE_ENV=production
DATABASE_URL=postgres://janus_migrator_login:replace-me@postgres:5432/janus
JWT_SECRET_FILE=/run/secrets/api_jwt_secret
UBUDDY_ORGBENCH_REMOTE_INIT_ACK=I_UNDERSTAND_REMOTE_DATABASE_WILL_BE_MODIFIED
UBUDDY_ORGBENCH_JANUS_BASE_URL=http://cloud-api:8787
UBUDDY_ORGBENCH_INIT_OUTPUT_DIR=/var/lib/janus/orgbench-init
# Optional: stable seed for deterministic password derivation; if omitted, one is generated on first creation.
# UBUDDY_ORGBENCH_PASSWORD_SEED=replace-with-private-seed
