    "horizon":{"type":"integer","minimum":1,"maximum":8},
    "initialState":{"type":"string"},
    "states":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["EFFECT_POSSIBLE","CRASHED","RESTARTED","RECEIPT_QUERY","IN_DOUBT","EFFECT_CONFIRMED","NO_EFFECT_CONFIRMED","COMPENSATION_PENDING","REMEDIATED","MANUAL_INTERVENTION"]}},
    "transitions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/transition"}},
