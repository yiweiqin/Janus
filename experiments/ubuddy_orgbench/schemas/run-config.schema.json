{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://janus.local/schemas/ubuddy-orgbench/run-config.schema.json",
  "title": "uBuddy-AppWorld remote run config",
  "type": "object", "required": ["benchmark", "adapter", "methods", "seeds", "split"],
  "properties": {
    "benchmark": {"const": "ubuddy_orgbench_v2"}, "adapter": {"enum": ["AppWorld", "TheAgentCompany", "synthetic"]},
    "methods": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "split": {"enum": ["development", "validation", "locked_test", "boundary"]}, "taskIds": {"type": "array", "items": {"type": "string"}},
    "faultManifest": {"type": "string"}, "outputDir": {"type": "string"}
  }
}
