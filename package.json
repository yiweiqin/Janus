  "keywords": [
    "janus",
    "codex",
    "agents",
    "self-evolution"
  ],
  "author": {
    "name": "Janus Team",
    "email": "dev@janus.local"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "build": {
    "appId": "local.janus.desktop",
    "productName": "Janus",
    "icon": "assets/icons/icon.png",
    "npmRebuild": false,
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "network/**/*",
      "assets/**/*",
      "!**/*.bak-*",
      "!**/*.orig",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "Janus Team <dev@janus.local>",
      "icon": "assets/icons/icon.png",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    }
  },
  "dependencies": {
    "@openai/codex": "0.145.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "pg-mem": "^3.0.14"
  }
}
