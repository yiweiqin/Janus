    "contract":{"type":"object","additionalProperties":false,"required":["rootAlgorithm","contractRoot","obligations"],"properties":{"rootAlgorithm":{"const":"sha256-canonical-json-v1"},"contractRoot":{"$ref":"#/$defs/digest"},"obligations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/obligation"}}}},
    "witness":{"type":"object","additionalProperties":false,"required":["witnessId","obligationId","instanceId","receiptId","effectType","sinkId","issuerId","nonce","version","receiptStatus"],"properties":{"witnessId":{"type":"string","minLength":1},"obligationId":{"type":"string","minLength":1},"instanceId":{"type":"string","minLength":1},"receiptId":{"type":"string","minLength":1},"effectType":{"type":"string","minLength":1},"sinkId":{"type":"string","minLength":1},"issuerId":{"type":"string","minLength":1},"nonce":{"type":"string","minLength":1},"version":{"type":"integer","minimum":0},"receiptStatus":{"const":"SUPPLIED_UNVERIFIED"}}},
    "event":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["kind","eventId","obligationId","instanceId","observedEventType"],"properties":{"kind":{"const":"TRIGGER"},"eventId":{"type":"string","minLength":1},"obligationId":{"type":"string","minLength":1},"instanceId":{"type":"string","minLength":1},"observedEventType":{"type":"string","minLength":1}}},
      {"type":"object","additionalProperties":false,"required":["kind","eventId","obligationId","instanceId","witness"],"properties":{"kind":{"const":"DISCHARGE"},"eventId":{"type":"string","minLength":1},"obligationId":{"type":"string","minLength":1},"instanceId":{"type":"string","minLength":1},"witness":{"$ref":"#/$defs/witness"}}},
      {"type":"object","additionalProperties":false,"required":["kind","eventId","obligationId","instanceId"],"properties":{"kind":{"const":"VIOLATE"},"eventId":{"type":"string","minLength":1},"obligationId":{"type":"string","minLength":1},"instanceId":{"type":"string","minLength":1}}},
      {"type":"object","additionalProperties":false,"required":["kind","eventId","obligationId","instanceId"],"properties":{"kind":{"const":"CANCEL"},"eventId":{"type":"string","minLength":1},"obligationId":{"type":"string","minLength":1},"instanceId":{"type":"string","minLength":1}}},
      {"type":"object","additionalProperties":false,"required":["kind","eventId","obligationId","instanceId","violationEventId","compensationTokenId"],"properties":{"kind":{"const":"COMPENSATE"},"eventId":{"type":"string","minLength":1},"obligationId":{"type":"string","minLength":1},"instanceId":{"type":"string","minLength":1},"violationEventId":{"type":"string","minLength":1},"compensationTokenId":{"type":"string","minLength":1}}},
      {"type":"object","additionalProperties":false,"required":["kind","eventId"],"properties":{"kind":{"const":"ACCEPT"},"eventId":{"type":"string","minLength":1}}}
    ]}
