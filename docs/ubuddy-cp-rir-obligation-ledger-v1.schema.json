  "properties":{
    "$schema":{"const":"ubuddy-cp-rir-obligation-ledger-v1.schema.json"},
    "schemaVersion":{"const":"cp-rir/obligation-ledger/v1"},
    "normativeRegistry":{"type":"object","additionalProperties":false,"required":["sourceId","issuerId","independentFromCandidate","lockedBeforeCandidate","rootAlgorithm","registryRoot","signatureStatus","obligations"],"properties":{"sourceId":{"type":"string","minLength":1},"issuerId":{"type":"string","minLength":1},"independentFromCandidate":{"const":true},"lockedBeforeCandidate":{"const":true},"rootAlgorithm":{"const":"sha256-canonical-json-v1"},"registryRoot":{"$ref":"#/$defs/digest"},"signatureStatus":{"const":"NOT_IMPLEMENTED"},"obligations":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/obligation"}}}},
